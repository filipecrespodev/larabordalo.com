---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/libre-franklin';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';

import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { SITE, SOCIAL } from '../consts';
import { LANGS, LOCALES, href, splitPath, t, type Lang } from '../i18n/ui';
import Lightbox from '../components/Lightbox.astro';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  image?: ImageMetadata;
  /** Which nav entry is current. */
  section?: 'home' | 'books' | 'illustration' | 'about';
  home?: boolean;
}

const { lang, title, description, image, section, home = false } = Astro.props;
const ui = t(lang);
const pageTitle = title ? `${title} · ${SITE.name}` : ui.title;
const { path } = splitPath(Astro.url.pathname);
const canonical = new URL(href(path, lang), Astro.site);
const alternates = LANGS.map((l) => ({ lang: l, url: new URL(href(path, l), Astro.site) }));
const ogImage = image ? await getImage({ src: image, width: 1200, format: 'jpg' }) : undefined;
const nav = (['home', 'books', 'illustration', 'about'] as const).map((key) => ({
  key,
  label: ui.nav[key],
  url: href(key === 'home' ? '/' : `/${key}`, lang),
}));
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={LOCALES[lang].html}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? ui.description} />
    <meta name="keywords" content={SITE.keywords} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.url} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0].url} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description ?? ui.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={LOCALES[lang].og} />
    {ogImage && <meta property="og:image" content={new URL(ogImage.src, Astro.site)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        if (sessionStorage.getItem('wipe') && !matchMedia('(prefers-reduced-motion: reduce)').matches)
          document.documentElement.classList.add('wiping');
        sessionStorage.removeItem('wipe');
      } catch (_) {}
    </script>
  </head>
  <body>
    <div class="wipe" id="wipe" aria-hidden="true"></div>
    <div class="cur" id="cur" aria-hidden="true"><div class="cur-pill" id="curTxt"></div></div>

    <header class="top" id="top">
      <a class="id" href={href('/', lang)}><span>{SITE.name}</span><span>{ui.role}</span></a>
      <div class="top-right">
        <nav class="nav" aria-label="Main">
          {
            nav.map((n) => (
              <a href={n.url} aria-current={n.key === section ? 'page' : undefined}>
                <span class="roll">
                  <span>{n.label}</span>
                  <span aria-hidden="true">{n.label}</span>
                </span>
              </a>
            ))
          }
        </nav>
        <div class="lang">
          {
            alternates.map((a) => (
              <a
                href={href(path, a.lang)}
                hreflang={a.lang}
                lang={a.lang}
                aria-current={a.lang === lang ? 'true' : undefined}
                aria-label={t(a.lang).langName}
              >
                {a.lang}
              </a>
            ))
          }
        </div>
      </div>
    </header>

    <main id="main">
      <section class:list={['page', { 'page-home': home }]}>
        <slot />
        <footer class="foot">
          <span>© {year} {SITE.name} · {ui.foot.rights}</span>
          <span class="foot-social">
            {
              SOCIAL.map((s) => (
                <a href={s.href} target="_blank" rel="noopener">
                  {s.label}
                </a>
              ))
            }
          </span>
          <button class="toplink" type="button" data-top>{ui.foot.top}</button>
        </footer>
      </section>
    </main>

    <Lightbox lang={lang} />

    <script>
      const $ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => r.querySelector<T>(s);
      const $$ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => [
        ...r.querySelectorAll<T>(s),
      ];
      const root = document.documentElement;
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const fine = matchMedia('(hover:hover) and (pointer:fine)').matches;

      // Header height, used by sticky offsets and the moodboard.
      const top = $('#top')!;
      new ResizeObserver(() => root.style.setProperty('--hdr', `${top.offsetHeight}px`)).observe(top);

      // Full-width titles: scale each `.fit` so its text fills the column.
      function fit(el: HTMLElement) {
        const inner = $('.fit-in', el);
        if (!inner || !el.clientWidth) return;
        el.style.fontSize = '100px';
        const w = inner.getBoundingClientRect().width;
        if (!w) return;
        let size = (100 * el.clientWidth) / w;
        const cap = parseFloat(el.dataset.cap || '0');
        if (cap) size = Math.min(size, (cap * innerWidth) / 100);
        el.style.fontSize = `${size.toFixed(2)}px`;
      }
      const fitAll = () => $$('.fit').forEach(fit);
      fitAll();
      document.fonts?.ready.then(fitAll);
      let rz = 0;
      addEventListener('resize', () => {
        clearTimeout(rz);
        rz = window.setTimeout(fitAll, 80);
      });

      // Blue curtain between pages: cover on leave, uncover on arrival.
      const wipe = $('#wipe')!;
      if (root.classList.contains('wiping')) {
        wipe.className = 'wipe out';
        root.classList.remove('wiping');
        setTimeout(() => (wipe.className = 'wipe'), 460);
      }
      addEventListener('pageshow', (e) => {
        if (e.persisted) {
          wipe.className = 'wipe';
          root.classList.remove('wiping');
        }
      });
      document.addEventListener('click', (e) => {
        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        const a = (e.target as Element).closest<HTMLAnchorElement>('a[href]');
        if (!a || a.target || a.hasAttribute('download') || a.dataset.lb !== undefined) return;
        const url = new URL(a.href);
        if (url.origin !== location.origin || url.pathname === location.pathname) return;
        if (reduce) return;
        e.preventDefault();
        try {
          sessionStorage.setItem('wipe', '1');
        } catch (_) {}
        wipe.className = 'wipe in';
        setTimeout(() => (location.href = a.href), 430);
      });

      // Back to top, copy-to-clipboard.
      document.addEventListener('click', (e) => {
        const target = e.target as Element;
        if (target.closest('[data-top]')) scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
        const c = target.closest<HTMLElement>('[data-copy]');
        if (c) {
          const old = c.textContent;
          const done = (m?: string) => {
            c.textContent = m ?? old;
            setTimeout(() => (c.textContent = old), 1800);
          };
          navigator.clipboard
            ?.writeText(c.dataset.copy!)
            .then(() => done(c.dataset.done))
            .catch(() => done(c.dataset.fail));
        }
      });

      // Cursor pill on elements with data-cursor.
      if (fine) {
        const cur = $('#cur')!;
        const txt = $('#curTxt')!;
        const lb = $('#lb')!;
        let tx = 0,
          ty = 0,
          x = 0,
          y = 0,
          ra = 0;
        const tick = () => {
          x += (tx - x) * 0.25;
          y += (ty - y) * 0.25;
          cur.style.transform = `translate3d(${x}px,${y}px,0)`;
          ra = Math.abs(tx - x) + Math.abs(ty - y) > 0.3 ? requestAnimationFrame(tick) : 0;
        };
        addEventListener(
          'pointermove',
          (e) => {
            tx = e.clientX;
            ty = e.clientY;
            if (!ra) ra = requestAnimationFrame(tick);
          },
          { passive: true },
        );
        document.addEventListener('pointerover', (e) => {
          const t = (e.target as Element).closest?.<HTMLElement>('[data-cursor]');
          if (t && lb.hidden) {
            txt.textContent = t.dataset.cursor!;
            cur.classList.add('on');
          } else cur.classList.remove('on');
        });
        document.addEventListener('pointerleave', () => cur.classList.remove('on'));
      }
    </script>
  </body>
</html>
