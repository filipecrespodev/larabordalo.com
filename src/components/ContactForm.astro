---
import { SITE, WEB3FORMS_KEY } from '../consts';
import { t, type Lang } from '../i18n/ui';

const { lang } = Astro.props as { lang: Lang };
const about = t(lang).about;
const ui = about.form;
---

<div class="cform">
  <p class="hello">{about.hello}</p>
  <form
    class="contact-form"
    method="post"
    action="https://api.web3forms.com/submit"
    data-key={WEB3FORMS_KEY}
    data-email={SITE.email}
    data-error={ui.error(SITE.email)}
  >
    <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
    <input type="hidden" name="subject" value="New message from larabordalo.com" />
    <input type="hidden" name="from_name" value="larabordalo.com" />
    <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <label>{ui.name}<input type="text" name="name" autocomplete="name" /></label>
    <label>{ui.email}<input type="email" name="email" autocomplete="email" required /></label>
    <label>{ui.message}<textarea name="message" required></textarea></label>
    <button type="submit" class="btn">{ui.send} →</button>
    <p class="err" role="alert" hidden></p>
  </form>
  <p class="sent" role="status" hidden>{ui.sent}</p>
</div>

<script>
  const form = document.querySelector<HTMLFormElement>('.contact-form')!;
  const sent = document.querySelector<HTMLElement>('.cform .sent')!;
  const error = form.querySelector<HTMLElement>('.err')!;
  const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    error.hidden = true;
    const data = new FormData(form);

    // No form service configured: hand the message over to the mail app.
    if (!form.dataset.key) {
      const subject = encodeURIComponent(`Message from ${data.get('name') || data.get('email')}`);
      const body = encodeURIComponent(`${data.get('message')}\n\n${data.get('name') ?? ''} <${data.get('email')}>`);
      window.location.href = `mailto:${form.dataset.email}?subject=${subject}&body=${body}`;
      return;
    }

    button.disabled = true;
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: data,
      });
      const json = await res.json();
      if (!res.ok || !json.success) throw new Error(json.message || res.statusText);
      form.hidden = true;
      sent.hidden = false;
    } catch {
      error.textContent = form.dataset.error!;
      error.hidden = false;
    } finally {
      button.disabled = false;
    }
  });
</script>
