---
import { SOCIAL } from '../consts';
import SocialIcon from './SocialIcon.astro';
---

<ul class="social">
  {
    SOCIAL.map((s) => (
      <li>
        <a
          href={s.href}
          aria-label={s.label}
          {...(s.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}
        >
          <SocialIcon icon={s.icon} />
        </a>
      </li>
    ))
  }
</ul>
