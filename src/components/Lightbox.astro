---
// Fullscreen viewer for every `a[data-lb]` link. Links in the same
// `[data-lb-group]` are browsed together. Captions come from data-title,
// data-meta and data-href (project link). Without JS the links open the image.
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/ui';

const { lang } = Astro.props as { lang: Lang };
const ui = t(lang).lightbox;
---

<div class="lb" id="lb" hidden role="dialog" aria-modal="true" aria-label={ui.label} data-open={ui.open}>
  <div class="lb-top">
    <span id="lbCount"></span><button class="btn" type="button" id="lbClose">{ui.close}</button>
  </div>
  <figure class="lb-fig"><img id="lbImg" alt="" /></figure>
  <div class="lb-bot">
    <div class="lb-cap" id="lbCap"></div>
    <div class="lb-nav">
      <button class="btn" type="button" id="lbPrev">{ui.prev}</button><button class="btn" type="button" id="lbNext"
        >{ui.next}</button
      >
    </div>
  </div>
</div>

<script>
  const lb = document.getElementById('lb')!;
  const img = document.getElementById('lbImg') as HTMLImageElement;
  const cap = document.getElementById('lbCap')!;
  const count = document.getElementById('lbCount')!;
  const prev = document.getElementById('lbPrev')!;
  const next = document.getElementById('lbNext')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let list: HTMLAnchorElement[] = [];
  let index = 0;
  let from: HTMLElement | null = null;

  const el = (tag: string, text: string) => Object.assign(document.createElement(tag), { textContent: text });

  function render() {
    const a = list[index];
    img.style.animation = 'none';
    void img.offsetWidth;
    img.style.animation = '';
    img.src = a.href;
    img.alt = a.querySelector('img')?.alt ?? '';
    cap.replaceChildren();
    if (a.dataset.title) cap.append(el('b', a.dataset.title));
    if (a.dataset.meta) cap.append(el('span', a.dataset.meta));
    if (a.dataset.href) {
      const link = el('a', lb.dataset.open!) as HTMLAnchorElement;
      link.href = a.dataset.href;
      cap.append(link);
    }
    count.textContent = `${String(index + 1).padStart(2, '0')} / ${String(list.length).padStart(2, '0')}`;
    prev.hidden = next.hidden = list.length < 2;
    for (const j of [index + 1, index - 1]) new Image().src = list[(j + list.length) % list.length].href;
  }
  const step = (d: number) => {
    index = (index + d + list.length) % list.length;
    render();
  };
  function open(a: HTMLAnchorElement) {
    const group = a.closest('[data-lb-group]') ?? document;
    list = [...group.querySelectorAll<HTMLAnchorElement>('a[data-lb]')].filter((x) => x.offsetParent !== null);
    index = Math.max(0, list.indexOf(a));
    from = document.activeElement as HTMLElement;
    lb.hidden = false;
    document.body.style.overflow = 'hidden';
    render();
    void lb.offsetWidth;
    lb.classList.add('on');
    document.getElementById('lbClose')!.focus();
  }
  function close() {
    lb.classList.remove('on');
    document.body.style.overflow = '';
    setTimeout(() => (lb.hidden = true), reduce ? 0 : 300);
    from?.focus();
  }

  document.addEventListener('click', (e) => {
    const a = (e.target as Element).closest<HTMLAnchorElement>('a[data-lb]');
    if (!a || e.metaKey || e.ctrlKey || e.shiftKey) return;
    e.preventDefault();
    open(a);
  });
  document.getElementById('lbClose')!.addEventListener('click', close);
  prev.addEventListener('click', () => step(-1));
  next.addEventListener('click', () => step(1));
  lb.addEventListener('click', (e) => {
    const target = e.target as Element;
    if (target === lb || target.classList.contains('lb-fig')) close();
  });
  addEventListener('keydown', (e) => {
    if (lb.hidden) return;
    if (e.key === 'Escape') close();
    else if (e.key === 'ArrowLeft' && list.length > 1) step(-1);
    else if (e.key === 'ArrowRight' && list.length > 1) step(1);
  });
  let touchX = 0;
  lb.addEventListener('touchstart', (e) => (touchX = e.touches[0].clientX), { passive: true });
  lb.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - touchX;
    if (list.length > 1 && Math.abs(dx) > 50) step(dx < 0 ? 1 : -1);
  });
</script>
