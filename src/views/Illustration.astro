---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import FitTitle from '../components/FitTitle.astro';
import { href, t, type Lang } from '../i18n/ui';
import { getProjects, localize } from '../lib/projects';

const { lang } = Astro.props as { lang: Lang };
const ui = t(lang);
const works = (await getProjects()).filter((p) => p.data.kind === 'illustration');
const cards = works.map((p) => ({ p, text: localize(p, lang) }));
const categories = [...new Set(cards.map((c) => c.text.category).filter((c): c is string => !!c))];
// Relative wall size: base width by `size`, adjusted for the image shape.
const BASE = { s: 62, m: 84, l: 112 };
const cm = (p: (typeof works)[number]) => {
  const ar = p.data.cover.width / p.data.cover.height;
  return Math.round(BASE[p.data.size] * Math.min(1.25, Math.max(0.75, Math.sqrt(ar))));
};
---

<Base lang={lang} title={ui.nav.illustration} section="illustration" image={works[0]?.data.cover}>
  <div class="ph">
    <div class="ph-meta"><span>{ui.illustration.meta}</span><span>{ui.illustration.note}</span></div>
    <FitTitle text={ui.nav.illustration} cap={24} />
  </div>
  <div class="tools">
    <div class="chips" id="chips" role="group" aria-label={ui.illustration.filter}>
      <button class="chip" type="button" data-f="" aria-pressed="true">{ui.illustration.all}</button>
      {
        categories.map((c) => (
          <button class="chip" type="button" data-f={c} aria-pressed="false">
            {c}
          </button>
        ))
      }
    </div>
    <span class="count" id="pcount" data-one={ui.illustration.works(1)} data-many={ui.illustration.works(2)}
      >{ui.illustration.works(works.length)}</span
    >
  </div>
  <div class="wall" id="wall">
    {
      cards.map(({ p, text }, i) => (
        <a
          class="pc"
          href={href(`/${p.id}`, lang)}
          style={`--cm:${cm(p)};--i:${i}`}
          data-cat={text.category ?? ''}
          data-cursor={ui.cursor.view}
        >
          <Image
            src={p.data.cover}
            alt={text.title}
            widths={[320, 480, 720, 960].filter((w) => w <= p.data.cover.width)}
            sizes="(max-width: 700px) 70vw, 30vw"
            format="webp"
            quality={82}
            loading={i < 4 ? 'eager' : 'lazy'}
          />
          <span class="cap">
            <b>
              {text.title}
              {p.data.year && `, ${p.data.year}`}
            </b>
            {text.medium}
          </span>
        </a>
      ))
    }
  </div>
</Base>

<script>
  const chips = document.getElementById('chips')!;
  const count = document.getElementById('pcount')!;
  const cards = [...document.querySelectorAll<HTMLElement>('#wall .pc')];
  chips.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLElement>('.chip');
    if (!b) return;
    const f = b.dataset.f!;
    chips.querySelectorAll('.chip').forEach((c) => c.setAttribute('aria-pressed', String(c === b)));
    let n = 0;
    cards.forEach((c, i) => {
      const show = !f || c.dataset.cat === f;
      c.hidden = !show;
      if (show) c.style.setProperty('--i', String(n++));
      // Restart the entrance animation.
      c.style.animation = 'none';
      void c.offsetWidth;
      c.style.animation = '';
      void i;
    });
    count.textContent = (n === 1 ? count.dataset.one! : count.dataset.many!).replace(/^\d+/, String(n));
  });
</script>
